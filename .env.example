# Local-first safe defaults; environment keys should be set in backend process.
HOST=127.0.0.1
PORT=3001
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Optional external AI, never mandatory:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
COMPATIBLE_API_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
# Explicitly enable only if local model runs on a remote approved host:
ALLOW_REMOTE_OLLAMA=0
# Siemens requires the exact licensed product API base URL and account rights:
SIEMENS_API_BASE=
SIEMENS_API_TOKEN=
AI_TIMEOUT_MS=90000
# For frontend integrations running on another explicit origin (comma-separated):
ALLOWED_ORIGINS=

# Optional REA (morluto/rea); disabled until explicitly configured:
# Install REA independently from https://github.com/morluto/rea (npm install -g rea-agents).
# Requires Node.js >=22.19 or >=24.11 or >=26. The RoboForge runtime may be older.
REA_ENABLED=0
# Absolute directories permitted for on-demand analysis. Use : on Linux, ; on Windows.
REA_ALLOWED_ROOTS=
# Optional trusted administrator-only CLI path (default: rea on PATH). Never set from browser.
REA_BIN=rea
REA_TIMEOUT_MS=90000

# OPTIONAL local MCP gateway: disabled by default. Local HTTP only, no credentials.
# ChromaNeural must explicitly approve connection and EACH tool.
ROBOFORGE_MCP_ENABLED=0
# Separate Refract Studio checkout, compiler-preview only; no CPA execution.
REFRACT_ENABLED=0
REFRACT_ROOT=
REFRACT_PYTHON=python3
# Janus remains optional and not connected to an inference runtime in v0.4.0.
JANUS_ENABLED=0

# EXPERIMENTAL / LOCAL-ONLY: ChromaNeural-managed MCP mode. Default OFF.
# Separate from ROBOFORGE_MCP_ENABLED; neither enables the other.
# Requires a trusted ChromaNeural Ed25519 PUBLIC key; never place a private key here.
ROBOFORGE_CHROMANEURAL_MANAGED=0
ROBOFORGE_CHROMANEURAL_PUBLIC_KEY_FILE=
# Explicit, stable, owner-authorized session identifier (not a secret):
ROBOFORGE_CHROMANEURAL_SESSION_ID=
# Absolute directory pre-created with chmod 700 by the RoboForge process owner.
# Needs durable local storage; do NOT use /tmp or an ephemeral container volume.
ROBOFORGE_GRANT_STATE_DIR=

# ChromaPlex Coding Agent (separate Linux application from Janus5G/Chromaplex-Coding-Agent)
# No code execution, binary build, flash or model download is enabled by these options.
CHROMAPLEX_AGENT_ENABLED=0
# Absolute path to trusted installed Coding Agent Python package root, e.g. /opt/chromaplex-coding-agent
CHROMAPLEX_AGENT_ROOT=
CHROMAPLEX_AGENT_PYTHON=python3
# Optional: absolute directories for independent verification of pre-existing build artifacts
CHROMAPLEX_AGENT_VERIFY_ROOTS=
